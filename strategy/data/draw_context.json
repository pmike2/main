{
	"add_dir_shaders" : ["../shaders"],
	"add_shaders" : ["../../shaders/repere", "../../shaders/font", "../../shaders/font3d", "../../shaders/gl_ihm"],
	"contexts" : {
		"repere" : {"shader" : "repere", "mode" : "GL_LINES", "active" : false},
		"ground" : {"shader" : "repere", "mode" : "GL_TRIANGLES", "active" : false},
		"box" : {"shader" : "repere", "mode" : "GL_LINES", "active" : false},
		"font" : {"shader" : "font", "mode" : "GL_TRIANGLES", "usage" : "GL_STREAM_DRAW"},
		"font3d" : {"shader" : "font3d", "mode" : "GL_TRIANGLES", "usage" : "GL_STREAM_DRAW"},
		"gl_ihm" : {"shader" : "gl_ihm", "mode" : "GL_TRIANGLES"},

		"debug, grid" : {"shader" : "linear", "mode" : "GL_LINES", "active" : false},
		"select, bbox" : {"shader" : "select", "mode" : "GL_LINES"},
		
		"path, selection, edit_map, cursor" : {"shader" : "dash", "mode" : "GL_LINES"},

		"elevation" : {"shader" : "elevation", "mode" : "GL_TRIANGLES", "usage" : "GL_DYNAMIC_DRAW"},
		"tree_stone" : {"shader" : "tree_stone", "mode" : "GL_TRIANGLES"},
		"river" : {"shader" : "river", "mode" : "GL_TRIANGLES"},
		"lake" : {"shader" : "lake", "mode" : "GL_TRIANGLES"},
		"sea" : {"shader" : "sea", "mode" : "GL_TRIANGLES"},
		"unit_life" : {"shader" : "unit_life", "mode" : "GL_TRIANGLES"},
		"overview" : {"shader" : "overview", "mode" : "GL_TRIANGLES"},
		"construction" : {"shader" : "construction", "mode" : "GL_TRIANGLES"},
		"explosion" : {"shader" : "explosion", "mode" : "GL_TRIANGLES"},

		"bomb, bullet, water_land_missile, barrier_basic" : {"shader" : "ammo", "mode" : "GL_TRIANGLES",
			"buffers" : [
				{"instanced" : true, "attrs" : ["model2world_matrix"]}
			]
		},
		
		"infantery, tank, helicopter, boat, submarine" : {
			"shader" : "unit", "mode" : "GL_TRIANGLES", "usage" : "GL_DYNAMIC_DRAW",
			"buffers" : [
				{"instanced" : true, "attrs" : ["model2world_matrix", "team_color_in", "hit_in", "alpha_in"]}
			]
		}
	}
